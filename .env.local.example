ANTHROPIC_API_KEY=your_api_key_here

# Required for generating the improved images (Google AI Studio key).
# Without it the app still produces designer-ready briefs for every image.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the image model (default: gemini-3.1-flash-image)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
